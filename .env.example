# VoxPilot AI - root env example (copy to backend/.env for local dev)
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:4200
JWT_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-another-long-random-string
MASTER_KEY=change-me-32-bytes-minimum!!change-me
MONGODB_URI=
REDIS_URL=
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=voxpilot-recordings
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_URL=
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
NVIDIA_API_KEY=
NVIDIA_BASE_URL=

# =====================================================================
# VoxPilot AI — local setup (copy to backend/.env, then edit secrets)
# AI provider keys are NOT configured here — enter them in the app
# under Providers (they are stored encrypted in the database).
# =====================================================================

# Server
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:4200
DATA_DIR=./data

# MongoDB (optional — app falls back to the built-in file store if unreachable)
MONGODB_URI=mongodb://127.0.0.1:27017/voxpilot

# --- Secrets: generate your own (e.g.: openssl rand -hex 32) ---
JWT_SECRET=REPLACE_WITH_RANDOM_32_BYTES_HEX
JWT_REFRESH_SECRET=REPLACE_WITH_ANOTHER_RANDOM_32_BYTES_HEX
MASTER_KEY=REPLACE_WITH_RANDOM_32_BYTES_HEX_FOR_KEY_ENCRYPTION

# Recording storage (optional — files stay on local disk when empty)
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=voxpilot-recordings
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Logging (debug|info|warn|error)
LOG_LEVEL=info
